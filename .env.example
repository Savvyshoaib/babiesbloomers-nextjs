# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signed session cookie (generate a long random string)
SESSION_SECRET=replace-with-a-long-random-secret

# Google SMTP (use a Gmail App Password — not your normal Gmail password)
# ALL transactional emails go through SMTP (orders, contact replies, reset password, welcome).
# In Supabase Dashboard → Authentication → Emails: turn OFF "Enable email confirmations"
# so Supabase does not send its own auth emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Babies Bloomers <your-gmail@gmail.com>

# Auto-promote this email to admin on sign-in /admin access
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
